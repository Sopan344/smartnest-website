<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SmartNest | Create Account</title>
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      margin: 0;
      background-color: #eef3fc;
      color: #111827;
    }

    /* Navbar */
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 15px 60px;
      background-color: white;
      border-bottom: 1px solid #e5e7eb;
    }

    .logo {
      display: flex;
      align-items: center;
      font-size: 22px;
      font-weight: 600;
      color: #2563eb;
    }

    .logo img {
      width: 28px;
      height: 28px;
      margin-right: 8px;
    }

    nav a {
      text-decoration: none;
      color: #111827;
      margin: 0 15px;
      font-weight: 500;
    }

    nav a:hover {
      color: #2563eb;
    }

    .auth-buttons button {
      margin-left: 10px;
      padding: 8px 18px;
      border-radius: 6px;
      border: none;
      cursor: pointer;
      font-weight: 500;
    }

    .login-btn {
      background-color: transparent;
      border: 1px solid #111827;
      color: #111827;
    }

    .signup-btn {
      background-color: #111827;
      color: white;
    }

    /* Signup Form */
    .signup-container {
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 80px 0;
    }

    .signup-box {
      background-color: white;
      border-radius: 12px;
      padding: 40px;
      width: 400px;
      box-shadow: 0 6px 12px rgba(0,0,0,0.08);
      text-align: center;
    }

    .signup-box h2 {
      font-size: 26px;
      margin-bottom: 10px;
    }

    .signup-box p {
      color: #6b7280;
      margin-bottom: 25px;
    }

    .signup-box input {
      width: 100%;
      padding: 10px;
      margin-bottom: 15px;
      border-radius: 6px;
      border: 1px solid #d1d5db;
      outline: none;
    }

    .signup-box label {
      display: block;
      text-align: left;
      font-weight: 500;
      margin-bottom: 5px;
    }

    .terms {
      display: flex;
      align-items: center;
      justify-content: left;
      gap: 8px;
      font-size: 14px;
      color: #4b5563;
      margin-top: 5px;
      margin-bottom: 20px;
    }

    .terms a {
      color: #2563eb;
      text-decoration: none;
    }

    .signup-main-btn {
      background-color: #0f172a;
      color: white;
      border: none;
      width: 100%;
      padding: 10px;
      border-radius: 6px;
      font-weight: 600;
      cursor: pointer;
    }

    @media(max-width:768px){
      header {
        flex-direction: column;
      }
      .signup-box {
        width: 90%;
      }
    }
  </style>
</head>
<body>

  <!-- Header -->
  <header>
    <div class="logo">
      <img src="https://cdn-icons-png.flaticon.com/512/869/869636.png" alt="logo">
      SmartNest
    </div>
    <nav>
      <a href="index.html">Home</a>
      <a href="search.html">Search</a>
      <a href="#">Recommendations</a>
      <a href="contact.html">Contact</a>
      <a href="#">Sell Property</a>
    </nav>
    <div class="auth-buttons">
      <button class="login-btn" onclick="window.location.href='login.html'">Login</button>
      <button class="signup-btn" onclick="window.location.href='signup.html'">Sign Up</button>
    </div>
  </header>

  <!-- Signup Form -->
  <section class="signup-container">
    <div class="signup-box">
      <div style="font-size:45px; color:#2563eb;">🧾</div>
      <h2>Create Account</h2>
      <p>Join SmartNest and start your home search journey</p>

      <form>
        <label>Full Name</label>
        <input type="text" placeholder="John Doe" required>
        
        <label>Email</label>
        <input type="email" placeholder="john@example.com" required>

        <label>Phone Number</label>
        <input type="text" placeholder="+1 (555) 123-4567" required>

        <label>Password</label>
        <input type="password" placeholder="••••••••" required>

        <label>Confirm Password</label>
        <input type="password" placeholder="••••••••" required>

        <div class="terms">
          <input type="checkbox" required>
          <label>I agree to the <a href="#">Terms and Conditions</a></label>
        </div>

        <button type="submit" class="signup-main-btn">Create Account</button>
      </form>
    </div>
  </section>

</body>
</html>
