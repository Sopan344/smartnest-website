<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SmartNest – Find Your Dream Home</title>
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      margin: 0;
      padding: 0;
      background-color: #ffffff;
      color: #111827;
    }

    /* Navbar */
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 15px 60px;
      background-color: white;
      border-bottom: 1px solid #e5e7eb;
      position: sticky;
      top: 0;
      z-index: 10;
    }

    .logo {
      display: flex;
      align-items: center;
      font-size: 22px;
      font-weight: 600;
      color: #2563eb;
    }

    .logo img {
      width: 28px;
      height: 28px;
      margin-right: 8px;
    }

    nav a {
      text-decoration: none;
      color: #111827;
      margin: 0 15px;
      font-weight: 500;
    }

    nav a:hover {
      color: #2563eb;
    }

    .auth-buttons button {
      margin-left: 10px;
      padding: 8px 18px;
      border-radius: 6px;
      border: none;
      cursor: pointer;
      font-weight: 500;
    }

    .login-btn {
      background-color: transparent;
      border: 1px solid #111827;
      color: #111827;
    }

    .signup-btn {
      background-color: #111827;
      color: white;
    }

    /* Hero Section */
    .hero {
      background-color: #1d4ed8;
      color: white;
      text-align: center;
      padding: 100px 20px;
    }

    .hero h1 {
      font-size: 44px;
      margin-bottom: 15px;
    }

    .hero p {
      font-size: 18px;
      margin-bottom: 30px;
    }

    .hero input {
      padding: 12px 15px;
      width: 320px;
      border-radius: 6px;
      border: none;
      outline: none;
    }

    .hero button {
      padding: 12px 20px;
      border: none;
      border-radius: 6px;
      background-color: #111827;
      color: white;
      font-weight: 500;
      cursor: pointer;
      margin-left: 10px;
    }

    .hero button:hover {
      background-color: #374151;
    }

    .hero .cta-buttons {
      margin-top: 30px;
    }

    .cta-buttons button {
      margin: 0 10px;
      padding: 10px 20px;
      border-radius: 6px;
      border: none;
      cursor: pointer;
      font-weight: 500;
    }

    .cta-buttons .primary {
      background-color: #f9fafb;
      color: #111827;
    }

    .cta-buttons .secondary {
      background-color: transparent;
      border: 1px solid white;
      color: white;
    }

    /* Featured Properties */
    .featured {
      padding: 80px 60px;
      text-align: center;
    }

    .featured h2 {
      font-size: 32px;
      margin-bottom: 10px;
    }

    .featured p {
      color: #6b7280;
      margin-bottom: 40px;
    }

    .properties {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 30px;
    }

    .property-card {
      background-color: white;
      border: 1px solid #e5e7eb;
      border-radius: 10px;
      width: 330px;
      text-align: left;
      overflow: hidden;
      box-shadow: 0 4px 8px rgba(0,0,0,0.05);
    }

    .property-card img {
      width: 100%;
      height: 230px;
      object-fit: cover;
    }

    .property-card h3 {
      font-size: 18px;
      margin: 15px 20px 5px 20px;
    }

    .property-card p {
      margin: 0 20px 10px 20px;
      color: #6b7280;
    }

    .property-card .details {
      font-size: 14px;
      color: #4b5563;
      margin: 0 20px 15px 20px;
    }

    .property-card .price {
      color: #2563eb;
      font-weight: 600;
      font-size: 18px;
      margin: 0 20px 20px 20px;
    }

    /* Why Choose */
    .whychoose {
      background-color: #ffffff;
      padding: 80px 60px;
      text-align: center;
    }

    .whychoose h2 {
      font-size: 32px;
      margin-bottom: 15px;
    }

    .whychoose p {
      color: #6b7280;
      margin-bottom: 40px;
    }

    .features {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 25px;
      justify-items: center;
    }

    .feature-box {
      border: 1px solid #e5e7eb;
      border-radius: 10px;
      padding: 25px;
      background-color: #f9fafb;
      width: 100%;
      max-width: 340px;
    }

    .feature-box h4 {
      margin: 15px 0 10px 0;
      color: #111827;
      font-size: 18px;
    }

    .feature-box p {
      color: #4b5563;
      font-size: 15px;
    }

    /* Footer */
    footer {
      background-color: #0f172a;
      color: white;
      padding: 60px;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
    }

    .footer-section {
      width: 250px;
      margin-bottom: 20px;
    }

    .footer-section h4 {
      margin-bottom: 10px;
      font-size: 18px;
    }

    .footer-section a {
      color: #9ca3af;
      display: block;
      text-decoration: none;
      margin: 6px 0;
      font-size: 15px;
    }

    .footer-section a:hover {
      color: white;
    }

    .social-icons {
      display: flex;
      gap: 12px;
      margin-top: 10px;
    }

    .social-icons i {
      font-size: 20px;
      cursor: pointer;
    }

    .footer-bottom {
      text-align: center;
      width: 100%;
      border-top: 1px solid #1e293b;
      margin-top: 40px;
      padding-top: 20px;
      color: #9ca3af;
    }

    @media(max-width:768px){
      header {
        flex-direction: column;
        align-items: flex-start;
      }
      nav {
        margin-top: 10px;
      }
      .properties {
        flex-direction: column;
        align-items: center;
      }
      footer {
        flex-direction: column;
      }
    }
  </style>
</head>
<body>

  <!-- Header -->
  <header>
    <div class="logo">
      <img src="https://cdn-icons-png.flaticon.com/512/869/869636.png" alt="logo">
      SmartNest
    </div>
    <nav>
      <a href="#">Home</a>
      <a href="#">Search</a>
      <a href="#">Recommendations</a>
      <a href="#">Contact</a>
      <a href="#">Sell Property</a>
    </nav>
    <div class="auth-buttons">
      <button class="login-btn">Login</button>
      <button class="signup-btn">Sign Up</button>
    </div>
  </header>

  <!-- Hero -->
  <section class="hero">
    <h1>Find Your Dream Home with SmartNest</h1>
    <p>Discover the perfect property with AI-powered recommendations and expert guidance</p>
    <div>
      <input type="text" placeholder="Enter location, city, or ZIP code...">
      <button>Search Properties</button>
    </div>
    <div class="cta-buttons">
      <button class="primary">Buy a Home</button>
      <button class="primary">Rent a Home</button>
      <button class="secondary">Sell Property</button>
    </div>
  </section>

  <!-- Featured Properties -->
  <section class="featured">
    <h2>Featured Properties</h2>
    <p>Handpicked properties just for you</p>
    <div class="properties">
      <div class="property-card">
        <img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=800&q=60" alt="">
        <h3>Modern Family House</h3>
        <p>Beverly Hills, CA</p>
        <p class="details">4 beds &nbsp;•&nbsp; 3 baths &nbsp;•&nbsp; 3,200 sqft</p>
        <p class="price">$1,250,000</p>
      </div>

      <div class="property-card">
        <img src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=800&q=60" alt="">
        <h3>Luxury Penthouse</h3>
        <p>Manhattan, NY</p>
        <p class="details">3 beds &nbsp;•&nbsp; 2 baths &nbsp;•&nbsp; 2,500 sqft</p>
        <p class="price">$2,800,000</p>
      </div>

      <div class="property-card">
        <img src="https://images.unsplash.com/photo-1613977257363-707ba9348227?auto=format&fit=crop&w=800&q=60" alt="">
        <h3>Beachfront Villa</h3>
        <p>Miami Beach, FL</p>
        <p class="details">5 beds &nbsp;•&nbsp; 4 baths &nbsp;•&nbsp; 4,800 sqft</p>
        <p class="price">$3,500,000</p>
      </div>
    </div>
  </section>

  <!-- Why Choose SmartNest -->
  <section class="whychoose">
    <h2>Why Choose SmartNest?</h2>
    <p>We combine cutting-edge technology with personalized service to make your real estate journey seamless</p>
    <div class="features">
      <div class="feature-box">
        <h4>Smart Search</h4>
        <p>Find your perfect home with our AI-powered search engine that understands your needs.</p>
      </div>
      <div class="feature-box">
        <h4>Dashboard Insight</h4>
        <p>Get real-time market trends and property valuations to make informed decisions.</p>
      </div>
      <div class="feature-box">
        <h4>AI Assistant</h4>
        <p>24/7 AI chatbot to answer all your real estate questions instantly.</p>
      </div>
      <div class="feature-box">
        <h4>Neighbourhood Insight Lifestyle Scoring</h4>
        <p>Discover lifestyle scores for neighborhoods including schools, amenities, and ratings.</p>
      </div>
      <div class="feature-box">
        <h4>Verified Listings</h4>
        <p>All properties are verified and authenticated for your peace of mind.</p>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer>
    <div class="footer-section">
      <div class="logo" style="color:white;">
        <img src="https://cdn-icons-png.flaticon.com/512/869/869636.png" alt="logo">
        SmartNest
      </div>
      <p>Your trusted partner in finding the perfect home. We make real estate smart and simple.</p>
      <div class="social-icons">
        <i>🌐</i><i>🐦</i><i>📸</i><i>💼</i>
      </div>
    </div>

    <div class="footer-section">
      <h4>Quick Links</h4>
      <a href="#">Home</a>
      <a href="#">Property Search</a>
      <a href="#">Recommendations</a>
      <a href="#">Sell Property</a>
    </div>

    <div class="footer-section">
      <h4>Services</h4>
      <a href="#">Buy Property</a>
      <a href="#">Rent Property</a>
      <a href="#">Property Valuation</a>
      <a href="#">AI Assistant</a>
    </div>

    <div class="footer-section">
      <h4>Contact Info</h4>
      <p>📍 580 Essex Street, Sydney</p>
      <p>📞 1234567890</p>
      <p>✉ info@smartnest.com</p>
    </div>

    <div class="footer-bottom">
      © 2025 SmartNest. All rights reserved.
    </div>
  </footer>

</body>
</html>

