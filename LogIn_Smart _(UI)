<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SmartNest | Login</title>
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      margin: 0;
      background-color: #eef3fc;
      color: #111827;
    }

    /* Navbar */
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 15px 60px;
      background-color: white;
      border-bottom: 1px solid #e5e7eb;
    }

    .logo {
      display: flex;
      align-items: center;
      font-size: 22px;
      font-weight: 600;
      color: #2563eb;
    }

    .logo img {
      width: 28px;
      height: 28px;
      margin-right: 8px;
    }

    nav a {
      text-decoration: none;
      color: #111827;
      margin: 0 15px;
      font-weight: 500;
    }

    nav a:hover {
      color: #2563eb;
    }

    .auth-buttons button {
      margin-left: 10px;
      padding: 8px 18px;
      border-radius: 6px;
      border: none;
      cursor: pointer;
      font-weight: 500;
    }

    .login-btn {
      background-color: transparent;
      border: 1px solid #111827;
      color: #111827;
    }

    .signup-btn {
      background-color: #111827;
      color: white;
    }

    /* Login Form */
    .login-container {
      display: flex;
      justify-content: center;
      align-items: center;
      height: calc(100vh - 100px);
    }

    .login-box {
      background-color: white;
      border-radius: 12px;
      padding: 40px;
      width: 400px;
      box-shadow: 0 6px 12px rgba(0,0,0,0.08);
      text-align: center;
    }

    .login-box h2 {
      font-size: 26px;
      margin-bottom: 10px;
    }

    .login-box p {
      color: #6b7280;
      margin-bottom: 25px;
    }

    .login-box input {
      width: 100%;
      padding: 10px;
      margin-bottom: 15px;
      border-radius: 6px;
      border: 1px solid #d1d5db;
      outline: none;
    }

    .remember {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 14px;
      margin-bottom: 15px;
    }

    .remember a {
      text-decoration: none;
      color: #2563eb;
    }

    .login-btn-main {
      background-color: #0f172a;
      color: white;
      border: none;
      width: 100%;
      padding: 10px;
      border-radius: 6px;
      font-weight: 600;
      cursor: pointer;
      margin-bottom: 20px;
    }

    .divider {
      border-top: 1px solid #e5e7eb;
      margin: 20px 0;
      position: relative;
    }

    .divider::before {
      content: "OR CONTINUE WITH";
      position: absolute;
      top: -12px;
      left: 50%;
      transform: translateX(-50%);
      background-color: white;
      padding: 0 10px;
      color: #9ca3af;
      font-size: 13px;
    }

    .social-buttons {
      display: flex;
      gap: 10px;
      justify-content: center;
    }

    .social-buttons button {
      flex: 1;
      border: 1px solid #d1d5db;
      background-color: white;
      border-radius: 6px;
      padding: 10px;
      cursor: pointer;
      font-weight: 500;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .social-buttons button:hover {
      background-color: #f9fafb;
    }

    @media(max-width:768px){
      header {
        flex-direction: column;
      }
      .login-box {
        width: 90%;
      }
    }
  </style>
</head>
<body>

  <!-- Header -->
  <header>
    <div class="logo">
      <img src="https://cdn-icons-png.flaticon.com/512/869/869636.png" alt="logo">
      SmartNest
    </div>
    <nav>
      <a href="index.html">Home</a>
      <a href="search.html">Search</a>
      <a href="#">Recommendations</a>
      <a href="contact.html">Contact</a>
      <a href="#">Sell Property</a>
    </nav>
    <div class="auth-buttons">
      <button class="login-btn">Login</button>
      <button class="signup-btn">Sign Up</button>
    </div>
  </header>

  <!-- Login Form -->
  <section class="login-container">
    <div class="login-box">
      <div style="font-size:45px; color:#2563eb;">➡️</div>
      <h2>Welcome Back</h2>
      <p>Sign in to your SmartNest account</p>

      <form>
        <input type="email" placeholder="john@example.com" required>
        <input type="password" placeholder="••••••••" required>
        <div class="remember">
          <label><input type="checkbox"> Remember me</label>
          <a href="#">Forgot password?</a>
        </div>
        <button type="submit" class="login-btn-main">Sign In</button>
      </form>

      <p style="font-size:14px;">Don’t have an account? <a href="#" style="color:#2563eb;">Sign up</a></p>

      <div class="divider"></div>

      <div class="social-buttons">
        <button>🟩 Google</button>
        <button>🔵 Facebook</button>
      </div>
    </div>
  </section>

</body>
</html>
